{
    "architecture": {
        "32bit": {
            "hash": "sha512:630c9a4a903349e51a887c28469f3866493054190f806d0aff4528de26435c69f0c98e2c6a1fea04752523b35e9320b1f0ce2fc379a9a3e54fd4a206f2740d32",
            "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/10.0.14/windowsdesktop-runtime-10.0.14-win-x86.exe"
        },
        "64bit": {
            "hash": "sha512:337dacab1636219147b3fe75e451bf5b1c17bca2c86328266d40c4ad1ff0a1e8391c4746ca7a5b702b65b61e8bfe834566cfc1b548cc10aef90b441357b10b69",
            "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/10.0.14/windowsdesktop-runtime-10.0.14-win-x64.exe"
        }
    },
    "autoupdate": {
        "architecture": {
            "32bit": {
                "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/$version/windowsdesktop-runtime-$version-win-x86.exe"
            },
            "64bit": {
                "url": "https://dotnetcli.blob.core.windows.net/dotnet/WindowsDesktop/$version/windowsdesktop-runtime-$version-win-x64.exe"
            }
        },
        "hash": {
            "mode": "extract",
            "url": "https://dotnetcli.blob.core.windows.net/dotnet/checksums/$version-sha.txt"
        }
    },
    "bin": "dotnet.exe",
    "checkver": {
        "regex": "(?s)([\\d.]+)[^\\d]*?(?<sdkversion>[\\d.]+)[^\\d]*?(?:current|lts)",
        "url": "https://dotnetcli.blob.core.windows.net/dotnet/release-metadata/releases-index.json"
    },
    "depends": "dark",
    "description": "The dotnet desktop runtime enables you to run dotnet desktop applications. This release includes the .NET Core Runtime, you do not need to install it separately.",
    "env_set": {
        "DOTNET_ROOT": "$dir"
    },
    "homepage": "https://dotnet.microsoft.com/",
    "installer": {
        "script": [
            "Expand-DarkArchive \"$dir\\$fname\" \"$dir\\extracted\" -Removal",
            "Get-ChildItem \"$dir\\extracted\\AttachedContainer\\*.msi\" | ForEach-Object { Expand-MsiArchive $_ \"$dir\" }",
            "Move-Item \"$dir\\dotnet\\*\" \"$dir\" -Force",
            "@('dotnet', 'extracted') | ForEach-Object { Remove-Item \"$dir\\$_\" -Recurse }"
        ]
    },
    "license": "MIT",
    "notes": "This package only contains the .NET Core runtime, install 'dotnet-sdk' instead if you need .NET Core SDK",
    "version": "10.0.14"
}
